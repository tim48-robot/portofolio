---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme: 'paper' | 'night';
  /** font files under /fonts used above the fold, preloaded so the first paint uses them */
  preloadFonts: string[];
}

const { title, description, theme, preloadFonts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'paper' ? '#f3f2ee' : '#030207'} />
    {preloadFonts.map((f) => (
      <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body class={`theme-${theme}`}>
    <slot />
  </body>
</html>
