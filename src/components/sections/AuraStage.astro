---
// The WebGL aura fills the screen; the stage marks where the portrait is drawn (the shader reads its position)
// and holds the button you hover and hold to charge.
interface Props {
  portrait: string;
  background: string;
  depth: string;
}
const { portrait, background, depth } = Astro.props;
---

<canvas id="gl" data-portrait={portrait} data-background={background} data-depth={depth}></canvas>
<p class="nogl">Your browser doesn't support WebGL2, so the aura can't render here.</p>
<div class="stage" id="stage">
  <button class="hit" id="hit" type="button" aria-label="Hold to charge the aura, release to burst"></button>
</div>
<div class="hint" aria-hidden="true">
  <span class="fine">HOVER TO AWAKEN · HOLD TO CHARGE</span>
  <span class="coarse">HOLD TO CHARGE · RELEASE</span>
</div>

<style>
  #gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }
  #gl:global(.shake) {
    animation: shake 0.45s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  @keyframes shake {
    0%,
    100% {
      transform: translate(0, 0);
    }
    10% {
      transform: translate(-14px, 8px);
    }
    25% {
      transform: translate(12px, -10px);
    }
    40% {
      transform: translate(-8px, 6px);
    }
    60% {
      transform: translate(5px, -4px);
    }
    80% {
      transform: translate(-2px, 2px);
    }
  }
  .nogl {
    position: absolute;
    inset: 0;
    margin: 0;
    display: none;
    place-items: end center;
    text-align: center;
    padding: 2rem 2rem 4rem;
    color: #aaa;
    font-size: 0.8rem;
  }
  :global(.nogl-on) .nogl {
    display: grid;
  }
  .stage {
    position: absolute;
    z-index: 2;
    right: 1vw;
    bottom: 0;
    height: min(98vh, 1100px);
    aspect-ratio: 6/7;
    pointer-events: none;
  }
  .hit {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 26%;
    bottom: 0;
    pointer-events: auto;
    cursor: pointer;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    border: 0;
    padding: 0;
    background: none;
  }
  .hit:focus-visible {
    outline: 1px dashed color-mix(in srgb, var(--hot) 55%, transparent);
    outline-offset: -10px;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: max(1.1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    z-index: 5;
    font: 600 0.75rem var(--f-code);
    letter-spacing: 0.24em;
    color: #b9b3cc;
    white-space: nowrap;
    opacity: calc(1 - var(--p) * 1.2);
    pointer-events: none;
    text-align: center;
    text-shadow: 0 1px 8px #030207;
  }
  .coarse {
    display: none;
  }
  @media (pointer: coarse) {
    .fine {
      display: none;
    }
    .coarse {
      display: inline;
    }
  }
  /* phones, tablets and portrait screens: the portrait is sized by the screen height and pinned near the top */
  @media (max-width: 880px), (orientation: portrait) and (max-width: 1180px) {
    .stage {
      right: auto;
      left: 50%;
      translate: -50% 0;
      bottom: auto;
      top: calc(3.2rem + 1svh);
      height: min(80svh, 150vw);
    }
    .hint {
      bottom: auto;
      top: calc(3.2rem + 1svh + min(80svh, 150vw) * 0.5);
      letter-spacing: 0.18em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #gl:global(.shake) {
      animation: none;
    }
  }
</style>

<style is:global>
  /* focus lines added by awaken/main.ts on release */
  .burst {
    position: absolute;
    z-index: 1;
    width: 250vmax;
    height: 250vmax;
    translate: -50% -50%;
    pointer-events: none;
    background: repeating-conic-gradient(from 0deg, #07040d 0 0.5deg, transparent 0.5deg 3.6deg);
    mask: radial-gradient(circle, transparent 9%, #000 15%, #000 30%, transparent 46%);
    animation: burst 0.62s cubic-bezier(0.15, 0.85, 0.3, 1) forwards;
  }
  @keyframes burst {
    0% {
      opacity: 1;
      transform: scale(0.45) rotate(0deg);
    }
    70% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: scale(var(--s)) rotate(4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .burst {
      animation: none;
      display: none;
    }
  }
</style>
