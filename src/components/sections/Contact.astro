---
import { site } from '../../content/site';

const icons = {
  github:
    'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z',
};
---

<footer class="foot" id="contact" aria-labelledby="foot-h">
  <div class="wrap">
    <h2 id="foot-h">{site.footer.heading}</h2>
    <div class="row">
      <div class="mail">
        <a id="email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <button class="mini" type="button" id="copy">
          copy
        </button>
      </div>
      <div class="socials">
        {site.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[s.icon]} />
              {s.icon === 'linkedin' && <circle cx="4" cy="4" r="2" />}
            </svg>
          </a>
        ))}
      </div>
    </div>
    <div class="fine">
      <span>{site.footer.credit}</span>
      <span>{site.footer.tagline}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    border-top: 3px solid var(--ink);
    background: var(--paper-2);
    overflow: hidden;
  }
  .wrap {
    position: relative;
    padding-block: 72px 28px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  h2 {
    margin: 0;
    font-size: clamp(46px, 8.5vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 600;
    max-width: 12ch;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-mono);
    font-size: 16px;
    min-width: 0;
    flex-wrap: wrap;
  }
  .mail a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .mail a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .socials {
    display: flex;
    gap: 12px;
  }
  .socials a {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--paper);
    transition:
      transform 0.5s var(--spring),
      background 0.2s;
  }
  .socials a:hover {
    transform: scale(1.2) rotate(10deg);
    background: var(--red);
  }
  .socials a:active {
    transform: scale(1.05);
  }
  .socials svg {
    width: 22px;
    height: 22px;
  }
  .fine {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 18px;
    margin-top: 22px;
  }
</style>
