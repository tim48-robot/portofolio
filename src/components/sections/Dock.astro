---
// Quick links under the panel. On phones the header links are hidden, so this is the main navigation there.
---

<div class="dock-row">
  <nav class="dock" aria-label="Sections">
    <a href="#projects">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="4" y="4" width="10" height="10" rx="2"></rect>
        <rect x="18" y="4" width="10" height="10" rx="2" fill="#e0262f" stroke="#0e0e10"></rect>
        <rect x="4" y="18" width="10" height="10" rx="2"></rect>
        <rect x="18" y="18" width="10" height="10" rx="2"></rect>
      </svg>
      Projects
    </a>
    <a href="#about" data-open-status>
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="6" width="26" height="20" rx="3"></rect>
        <circle cx="11" cy="15" r="3.5" fill="#e0262f" stroke="#0e0e10"></circle>
        <path d="M6.5 22c1-2.5 2.6-3.5 4.5-3.5s3.5 1 4.5 3.5M19 13h6M19 17h6M19 21h4"></path>
      </svg>
      About
    </a>
    <a href="#contact">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="7" width="26" height="18" rx="3"></rect>
        <path d="M4 9l12 9 12-9"></path>
        <circle cx="26" cy="8" r="4" fill="#e0262f" stroke="#0e0e10"></circle>
      </svg>
      Contact
    </a>
  </nav>
</div>

<style>
  .dock-row {
    display: flex;
    justify-content: center;
    padding-block: 18px 64px;
  }
  .dock {
    display: flex;
    gap: 6px;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow:
      0 10px 30px rgba(14, 14, 16, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 84px;
    padding: 12px 10px 10px;
    border-radius: 16px;
    font-size: 13px;
    text-decoration: none;
    transition:
      transform 0.5s var(--spring),
      background 0.2s;
  }
  svg {
    width: 30px;
    height: 30px;
    transition: transform 0.5s var(--spring);
  }
  a:hover {
    background: var(--paper);
    transform: translateY(-6px);
  }
  a:hover svg {
    transform: rotate(-8deg) scale(1.12);
  }
  a:active {
    transform: translateY(-2px) scale(0.93);
  }
</style>
