---
interface Props {
  id: string;
  lead: string;
  /** the word stamped in the red manhwa face */
  stamp: string;
  aside?: string;
}
const { id, lead, stamp, aside } = Astro.props;
---

<div class="sec-head">
  <h2 id={id}>
    {lead}
    <em>{stamp}</em>
  </h2>
  {aside && <span class="label">{aside}</span>}
</div>

<style>
  .sec-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.03em;
    font-weight: 600;
    line-height: 1;
  }
  em {
    font-style: normal;
    font-family: var(--f-sfx);
    font-weight: 400;
    color: var(--red);
    -webkit-text-stroke: 1px var(--ink);
    paint-order: stroke fill;
    text-shadow: 3px 3px 0 var(--ink);
    display: inline-block;
    transform: rotate(-4deg);
    margin-left: 0.15em;
  }
</style>
