---
import type { Project } from '../../types/content';

// The card illustration: a mock window over a manhwa background. 'logs' sketches the Log Explorer that
// was built; 'screentone' points at the hero effect itself.
interface Props {
  art: Project['art'];
}
const { art } = Astro.props;
const rows = [
  ['P-001', 'CONSENT_ACCEPTED', 'info'],
  ['P-002', 'TASK_STARTED', 'info'],
  ['P-001', 'RECORDING_FAILED', 'warn'],
  ['P-003', 'STUDY_SUBMITTED', 'info'],
];
---

<div class="art" aria-hidden="true">
  {art === 'logs' ? <div class="bg lines" /> : <div class="bg tone" />}
  {art === 'screentone' && <div class="sun" />}
  <div class="shot">
    <div class="bar">
      <i></i>
      <i></i>
      <i></i>
    </div>
    {art === 'logs' ? (
      <div class="logs">
        <div class="lh">
          <span>Participant</span>
          <span>Event</span>
          <span>Level</span>
        </div>
        {rows.map(([who, event, level]) => (
          <div>
            <span>{who}</span>
            <span>{event}</span>
            <span class:list={{ w: level === 'warn' }}>{level}</span>
          </div>
        ))}
      </div>
    ) : (
      <div class="ph">This hero effect, as its own little tool</div>
    )}
  </div>
</div>

<style>
  .art {
    position: relative;
    aspect-ratio: 16/10;
    border: 3px solid var(--ink);
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 0 0 var(--ink);
    transition:
      transform 0.6s var(--spring),
      box-shadow 0.6s var(--spring);
  }
  :global(.project:hover) .art {
    transform: translate(-4px, -4px) rotate(-0.6deg);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .bg {
    position: absolute;
    inset: 0;
    transition: transform 0.9s var(--ease);
  }
  :global(.project:hover) .bg {
    transform: scale(1.06);
  }
  .lines {
    background:
      radial-gradient(circle at 70% 38%, var(--red) 0 14%, transparent 14.5%),
      repeating-conic-gradient(from 0deg at 50% 50%, var(--ink) 0 0.9deg, transparent 0.9deg 5deg), var(--paper);
  }
  .tone {
    background:
      radial-gradient(circle, var(--ink) 1.6px, transparent 1.9px) 0 0/9px 9px,
      var(--paper);
    mask: linear-gradient(115deg, #000 10%, rgba(0, 0, 0, 0.15) 70%);
  }
  .sun {
    position: absolute;
    right: -8%;
    top: -20%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
    opacity: 0.9;
  }
  .shot {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 16%;
    bottom: -6%;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 0 18px 40px rgba(14, 14, 16, 0.25);
    display: flex;
    flex-direction: column;
    transition: transform 0.7s var(--spring);
  }
  :global(.project:hover) .shot {
    transform: translateY(-8px);
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 8px 10px;
    border-bottom: 2px solid var(--ink);
  }
  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .logs {
    flex: 1;
    display: flex;
    flex-direction: column;
    font-family: var(--f-mono);
    font-size: clamp(9px, 1vw, 11px);
    padding: 6px 10px;
    gap: 2px;
    overflow: hidden;
  }
  .logs > div {
    display: grid;
    grid-template-columns: 7.6em 1fr 3.5em;
    gap: 8px;
    padding: 4px 0;
    border-bottom: 1px dashed var(--line);
    white-space: nowrap;
  }
  .logs span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .logs .lh {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1.5px solid var(--ink);
  }
  .w {
    color: var(--red);
    font-weight: 600;
  }
  .ph {
    flex: 1;
    display: grid;
    place-items: center;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
    padding: 12px;
    text-align: center;
  }
</style>
